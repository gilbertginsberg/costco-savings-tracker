# All optional. Copy to .env.local for local dev; set in Vercel for production.

# Canonical site URL (used for metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://costcosavingstracker.com

# Amazon Associates tag, same as Kirkland Calc. Unset → no "Compare on Amazon" links.
NEXT_PUBLIC_AMAZON_TAG=

# Google AdSense. Unset → ad slots render nothing in production.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-9197346169922497
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_GRID=
NEXT_PUBLIC_ADSENSE_SLOT_ARCHIVE=

# Matomo site id (same Matomo account as Kirkland Calc; create a new site for this tool).
NEXT_PUBLIC_MATOMO_SITE_ID=

# Fetch job (scripts/fetch-deals.ts)
COSTCO_SAVINGS_URL=https://www.costco.com/o/-/warehouse-savings
FETCH_INTERVAL_DAYS=3
MIN_ITEMS=10
